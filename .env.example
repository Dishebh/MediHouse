# Local development only. Copy to .env; never commit real credentials.
NODE_ENV=development
PORT=5000

# Local MongoDB-compatible server started with `npm run db`
MONGO_URI=mongodb://127.0.0.1:27017/medihouse

COOKIE_KEY=local-dev-cookie-key-change-me
JWT_SECRET=local-dev-jwt-secret-change-me
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# Placeholders so the Google OAuth strategy can initialize; Google sign-in will not work with them.
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
REDIRECT_DOMAIN=http://localhost:3000
BASE_URL_DEV=http://localhost:3000
BASE_URL_PROD=

# SMS reminders are logged instead of sent while SMS_DISABLED=true or Twilio credentials are empty.
SMS_DISABLED=true
ACCOUNT_SID=
AUTH_TOKEN=
TWILIO_FROM=
